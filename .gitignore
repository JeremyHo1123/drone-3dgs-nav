# This repo tracks only what was written by hand, plus one published example
# scene. Capture videos, extracted images, SfM intermediates and training
# checkpoints total about 49 GB and are all reproducible or downloadable.

# ── ignore everything at the repo root by default ──
/*

# ── then allow back what belongs here ──
!/.gitignore
!/README.md
!/CLAUDE.md
!/implement.md
!/tools/
!/notes/
!/configs/
!/scenes/

# ── notes/ keeps its text; the screenshots stay local ──
notes/**/*.png
notes/**/*.jpg
notes/**/*.jpeg
notes/**/*.log

# ── never track these, anywhere ──
*.ckpt
*.MOV
*.mp4
*.zip
*.pyc
__pycache__/

# ── point clouds are large, except the ones published under scenes/ ──
*.ply
!scenes/**/*.ply
