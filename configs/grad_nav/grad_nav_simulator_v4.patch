+"""
+Replacement for write_video (added in this project).
+
+torchvision deprecated its video I/O in 0.22 and removed it in 0.26, so
+`from torchvision.io import write_video` fails with:
+
+    ImportError: cannot import name 'write_video' from 'torchvision.io'
+
+Five grad_nav environment files use it to save ego_video.mp4. This module provides a
+drop-in replacement with the same name and signature, based on imageio + imageio-ffmpeg;
+callers only change the import line.
+
+The calls are always:
+    write_video(path, tensor_uint8_THWC, fps=20)
+"""
+from pathlib import Path
+
+import numpy as np
+
+
+def write_video(filename, video_array, fps, video_codec="libx264", options=None):
+    """Write frames to a video file.
+
+    Args:
+        filename: output path.
+        video_array: (T, H, W, C) uint8 frames, torch.Tensor or numpy.
+                     Float input is treated as [0,1] and converted to uint8.
+        fps: frame rate.
+        video_codec: encoder, default libx264 (same as torchvision).
+        options: extra ffmpeg parameters as a dict, passed as output_params.
+
+    Differences from the torchvision version:
+        - no audio_array (grad_nav does not use it).
+        - macro_block_size=1, so the image is never silently rescaled to a multiple of 16.
+          torchvision does not do that, but imageio does by default, which would make the saved
+          video resolution differ from what the policy actually sees.
+    """
+    import imageio.v2 as imageio
+
+    arr = video_array
+    if hasattr(arr, "detach"):                      # torch.Tensor
+        arr = arr.detach().cpu().numpy()
+    arr = np.asarray(arr)
+
+    if arr.dtype != np.uint8:                       # float input is treated as [0,1]
+        arr = (np.clip(arr, 0.0, 1.0) * 255).astype(np.uint8)
+
+    if arr.ndim != 4 or arr.shape[-1] not in (1, 3):
+        raise ValueError(
+            f"write_video needs (T, H, W, C) with C = 1 or 3, got {arr.shape}")
+    if arr.shape[-1] == 1:
+        arr = np.repeat(arr, 3, axis=-1)
+
+    # H.264 yuv420p needs even width and height. With odd sizes libx264 fails,
+    # but imageio raises nothing and leaves an unreadable file (moov atom not found).
+    # A silent failure like that is hard to track down, so pad one row/column of edge pixels and warn.
+    h, w = arr.shape[1], arr.shape[2]
+    if h % 2 or w % 2:
+        import warnings
+        arr = np.pad(arr, ((0, 0), (0, h % 2), (0, w % 2), (0, 0)), mode="edge")
+        warnings.warn(
+            f"write_video: {w}x{h} has an odd side, which H.264 does not support; "
+            f"padded to {arr.shape[2]}x{arr.shape[1]}", stacklevel=2)
+
+    Path(filename).parent.mkdir(parents=True, exist_ok=True)
+    kwargs = dict(fps=fps, codec=video_codec, quality=8, macro_block_size=1)
+    if options:
+        kwargs["output_params"] = [x for kv in options.items() for x in kv]
+    imageio.mimwrite(filename, list(arr), **kwargs)
