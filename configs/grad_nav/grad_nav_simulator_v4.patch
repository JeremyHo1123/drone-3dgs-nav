+++ b/envs/assets/command_latency.py
@@ -0,0 +1,276 @@
+"""
+Added in this project (2026-10-19): the real drone's command latency and the motor response of the thrust, in the
+simulator used to train the orbit-the-box policy.
+
+Background: on 2026-10-19 the v2 policy flew on the real drone for the first time and both times oscillated up and
+down within 1-2 s (period about 0.9 s, growing) until the |vz| > 0.8 m/s safety check stopped it. In the original
+simulator a command takes effect in the same step and the thrust equals the command; the real drone adds about 55 ms
+of pipeline delay (pose to the Jetson, policy, command to PX4), the thrust goes through the motor response (20-40 ms
+when increasing, 60-150 ms when decreasing), and thrust scales with throttle to the power of about 1.3 (the onboard
+program assumed 1.67).
+
+Settings: LATENCY_MODEL (dict) in env_hyper. Without the key, or if enabled is not True, this class is not created and
+the environment runs the original code (step() in envs/drone_vla_long_task.py calls the original
+QuadrotorSimulator.run_simulation, unchanged).
+
+  LATENCY_MODEL:
+    enabled: True
+    delay: True              # command delay (body rates and thrust delayed together)
+    delay_ms: [30, 100]      # base delay d, drawn per drone and episode ("state measured" to "PX4 receives the command"); a single number = fixed, e.g. 55
+    jitter_ms: [0, 30]       # extra delay drawn for every command (every step); 0 = no jitter
+    motor: True              # motor response of the thrust + thrust-vs-throttle exponent
+    tau_up_ms: [15, 50]      # first-order time constant when the thrust increases (applied to the throttle)
+    tau_dn_ms: [50, 180]     # first-order time constant when the thrust decreases
+    p_real: [1.1, 1.6]       # real thrust ~ throttle^p_real
+    u_hover: [0.62, 0.69]    # real hover throttle (changes with battery voltage)
+    p_prog: 1.3              # exponent the onboard program uses to turn the sim thrust fraction into throttle (thrust_exponent in orbit_runtime.py)
+    t_hover_prog: 0.65       # hover throttle assumed by the onboard program (T_hover in orbit_runtime.py)
+    f_hover_prog: 0.2438     # hover thrust fraction of the onboard program (bundle meta hover_thrust_frac = 3.15 kg x g / 126.75)
+    thrust_ref: weight       # thrust formula (added 2026-10-20, see below): weight = m*g*(y/u_hover)^p_real (default);
+                             #   max_thrust = max_thrust*f_hover_prog*(y/u_hover)^p_real (mass and max_thrust randomisation still apply)
+    hist_len: 6              # number of past commands kept; must cover the maximum delay (6 steps = 250 ms)
+    hold_start_s: 0.0        # for this long after the episode start commands have no effect (zero rates, hover thrust): PX4 not yet in rate control
+
+Command delay: keep the last hist_len "mixed commands" (the omega and thrust fraction f sent to PX4; entry 0 is the one
+  just computed), each with its own delay (d + the jitter drawn for that step). Entry j was sent j*dt before this step
+  started and takes effect at -j*dt + delay. Each physics substep (time t_in within this step) uses the newest entry
+  already in effect. Without jitter this is
+      j = clamp(ceil((d - t_in) / dt), 0, hist_len - 1)
+  Example: d = 55 ms -> at t_in = 0 the command from two steps ago, from t_in >= 5 ms the previous step's; this step's
+  command takes effect 5 ms into the next step.
+  Jitter uses "each command its own delay, the newest arrived one wins" rather than one d per step: with a shared d, a
+  30 ms jump in d would replace a command already in effect by an older one, which the real drone never does (commands
+  are sent and arrive in order). Without jitter both give the same result.
+  Values are picked by index (gather), so gradients flow back to the step that produced the command.
+
+Motor response of the thrust (one throttle state y per drone; at episode start y = this drone's hover throttle y_hover, see below):
+      u_cmd = t_hover_prog * (f / f_hover_prog)^(1 / p_prog), clipped to 0-1     (the onboard program's conversion)
+      tau = tau_up if u_cmd > y else tau_dn
+      y <- y + (1 - exp(-h / tau)) * (u_cmd - y)                                 (h = physics substep, 200 Hz = 5 ms)
+      thrust = S * (y / u_hover)^p_real + the original thrust noise (N(0, 0.01) x max_thrust), along body z as before
+  S depends on thrust_ref (added 2026-10-20; the v3 training uses max_thrust, option (b)):
+    weight (default, formula (a)): S = m*g, y_hover = u_hover.
+      The thrust depends only on m*g, u_hover and p_real; the original max_thrust randomisation no longer affects the
+      thrust (max_thrust only sets the noise level), and the mass cancels in the acceleration except for air drag. The
+      hover thrust fraction varies only about +-7% (from u_hover alone), against about +-18% originally.
+      With p_prog = p_real and u_hover = t_hover_prog the steady thrust is m*g*f / f_hover_prog, which equals the
+      original "thrust = f x max_thrust" only for the nominal airframe (3.15 kg, 126.75).
+    max_thrust (b): S = max_thrust * f_hover_prog. On the nominal airframe S = m*g, identical to weight.
+      The original independent randomisation of mass and max_thrust still applies: u_hover becomes "the hover throttle
+      of the nominal airframe", and this drone's hover throttle is y_hover = u_hover * (m*g / S)^(1/p_real), clipped to
+      0-1 (about 0.53-0.82 over the training range).
+      With p_prog = p_real and u_hover = t_hover_prog the steady thrust is f x max_thrust for any mass and max_thrust,
+      exactly the original simulator (this model generalises it). Hover thrust fraction: 98% of the airframes within
+      -16% to +23% of nominal (originally -15% to +18%).
+  At episode start and during hold_start_s the throttle is y_hover (thrust = m*g: PX4 hovers by itself before hand-over).
+
+Body rates: delay only (the simulator already has a body-rate PD controller and inertia).
+Observation unchanged: "this step's and the previous step's command" seen by the policy are still the mixed commands
+before the delay (the onboard program puts the same into the observation).
+
+Gradients: all torch ops; the command history and the throttle state are new tensors every step (no in-place writes)
+and are cloned before being changed at an episode reset; the per-episode parameters (d, tau, p_real, u_hover) are also
+cloned before being changed (they are already in the graph, and in-place writes would break backprop).
+At the start of each BPTT segment (32 steps) detach_state() cuts the link to the previous segment (called from
+DroneVLAOrbitEnv.clear_grad).
+"""
+import math
+
+import torch
+
+DEFAULTS = dict(
+    enabled=False,
+    delay=True, delay_ms=[30.0, 100.0], jitter_ms=[0.0, 30.0],
+    motor=True, tau_up_ms=[15.0, 50.0], tau_dn_ms=[50.0, 180.0], p_real=[1.1, 1.6], u_hover=[0.62, 0.69],
+    p_prog=1.3, t_hover_prog=0.65, f_hover_prog=0.2438, thrust_ref="weight",
+    hist_len=6, hold_start_s=0.0,
+)
+THRUST_REFS = ("weight", "max_thrust")
+G = 9.81
+
+
+def _range(v):
+    """A setting is either a number (fixed) or [low, high] (uniform random)."""
+    if isinstance(v, (list, tuple)):
+        if len(v) != 2 or float(v[0]) > float(v[1]):
+            raise ValueError(f"LATENCY_MODEL ranges must be [low, high], got {v}")
+        return float(v[0]), float(v[1])
+    return float(v), float(v)
+
+
+class CommandLatency:
+    def __init__(self, cfg, num_envs, device, dt, init_command, quad=None):
+        """quad: the environment's QuadrotorSimulator (per-drone m and max_thrust). Required when thrust_ref is max_thrust."""
+        unknown = set(cfg) - set(DEFAULTS)
+        if unknown:
+            raise ValueError(f"LATENCY_MODEL has unknown keys: {sorted(unknown)} (known: {sorted(DEFAULTS)})")
+        c = dict(DEFAULTS)
+        c.update(cfg)
+        self.cfg = c
+        self.n = num_envs
+        self.device = device
+        self.dt = float(dt)
+        self.delay = bool(c["delay"])
+        self.motor = bool(c["motor"])
+        self.delay_rng = tuple(x / 1000.0 for x in _range(c["delay_ms"]))
+        self.jitter_rng = tuple(x / 1000.0 for x in _range(c["jitter_ms"]))
+        self.tau_up_rng = tuple(x / 1000.0 for x in _range(c["tau_up_ms"]))
+        self.tau_dn_rng = tuple(x / 1000.0 for x in _range(c["tau_dn_ms"]))
+        self.p_real_rng = _range(c["p_real"])
+        self.u_hover_rng = _range(c["u_hover"])
+        self.p_prog = float(c["p_prog"])
+        self.t_hover_prog = float(c["t_hover_prog"])
+        self.f_hover_prog = float(c["f_hover_prog"])
+        self.thrust_ref = str(c["thrust_ref"])
+        if self.thrust_ref not in THRUST_REFS:
+            raise ValueError(f"LATENCY_MODEL thrust_ref must be one of {THRUST_REFS}, got {self.thrust_ref}")
+        self.hold_start_s = float(c["hold_start_s"])
+        self.H = int(c["hist_len"])
+        if self.tau_up_rng[0] <= 0 or self.tau_dn_rng[0] <= 0:
+            raise ValueError("LATENCY_MODEL tau_up_ms and tau_dn_ms must be > 0")
+        max_delay = (self.delay_rng[1] + self.jitter_rng[1]) if self.delay else 0.0
+        need = math.ceil(max_delay / self.dt - 1e-9)          # how many steps back to look at t_in = 0
+        if self.H < max(need + 1, 2):
+            raise ValueError(f"LATENCY_MODEL hist_len={self.H} is too short: a maximum delay of {max_delay * 1000:.0f} ms needs at least {need + 1} steps")
+
+        self.env_idx = torch.arange(num_envs, device=device)
+        self.j_idx = torch.arange(self.H, device=device).unsqueeze(0).expand(num_envs, self.H)
+        self.j_last = torch.full_like(self.j_idx, self.H - 1)
+        self.j_dt = (torch.arange(self.H, device=device, dtype=torch.float32) * self.dt).unsqueeze(0)
+
+        # Parameters of disabled parts stay fixed (no random draws): disabled parts must not consume random numbers, or the physics noise would change
+        full = lambda v: torch.full((num_envs,), float(v), device=device)  # noqa: E731
+        self.d_base, self.tau_up, self.tau_dn = full(0.0), full(self.tau_up_rng[0]), full(self.tau_dn_rng[0])
+        self.p_real, self.u_hover = full(self.p_prog), full(self.t_hover_prog)
+        all_ids = torch.arange(num_envs, device=device)
+        self._sample(all_ids)
+        cmd = torch.as_tensor(init_command, device=device, dtype=torch.float32).reshape(1, 1, 4)
+        self.cmd_hist = cmd.expand(num_envs, self.H, 4).clone()
+        self.cmd_delay = torch.zeros(num_envs, self.H, device=device)
+        self.y = self._hover_throttle(quad).clone()
+
+        self.record = False          # tools (reproduction, evaluation) set True: store diagnostics in self.last every step
+        self.last = {}
+
+    # ------------------------------------------------------------------ per-episode parameters
+    def _uniform(self, rng, n):
+        lo, hi = rng
+        if hi > lo:
+            return lo + (hi - lo) * torch.rand(n, device=self.device)
+        return torch.full((n,), lo, device=self.device)
+
+    def _sample(self, env_ids):
+        """Redraw the parameters of these drones. Only enabled parts are drawn (fixed values use no random numbers)."""
+        n = len(env_ids)
+        groups = []
+        if self.delay:
+            groups.append(("d_base", self.delay_rng))
+        if self.motor:
+            groups += [("tau_up", self.tau_up_rng), ("tau_dn", self.tau_dn_rng),
+                       ("p_real", self.p_real_rng), ("u_hover", self.u_hover_rng)]
+        for name, rng in groups:
+            v = getattr(self, name).clone()          # clone before writing: the old tensor may already be in the graph
+            v[env_ids] = self._uniform(rng, n)
+            setattr(self, name, v)
+
+    def _hover_throttle(self, quad):
+        """Hover throttle y_hover of each drone (thrust = m*g). weight: u_hover itself; max_thrust: u_hover*(m*g / S)^(1/p_real), clipped to 0-1.
+        Without the motor response the throttle state is unused; u_hover is returned as before."""
+        if self.thrust_ref == "weight" or not self.motor:
+            return self.u_hover
+        if quad is None:
+            raise ValueError("LATENCY_MODEL thrust_ref: max_thrust needs each drone's mass and max_thrust: pass quad to the constructor and reset()")
+        ratio = quad.m * G / (quad.max_thrust * self.f_hover_prog)
+        return (self.u_hover * ratio ** (1.0 / self.p_real)).clamp(0.0, 1.0)
+
+    def reset(self, env_ids, actions, prev_actions, quad=None):
+        """Episode reset: redraw parameters; set the command history to the reset command (entry 0 = actions, the rest = prev_actions, all already in effect);
+        set the throttle state to this drone's hover throttle. actions / prev_actions are the environment's self.actions, self.prev_actions after the reset;
+        quad is the QuadrotorSimulator after the reset (mass and max_thrust redrawn), required when thrust_ref is max_thrust."""
+        self._sample(env_ids)
+        hist = self.cmd_hist.clone()
+        hist[env_ids, 0] = actions[env_ids].detach()
+        hist[env_ids, 1:] = prev_actions[env_ids].detach().unsqueeze(1)
+        self.cmd_hist = hist
+        dl = self.cmd_delay.clone()
+        dl[env_ids] = 0.0
+        self.cmd_delay = dl
+        y = self.y.clone()
+        y[env_ids] = self._hover_throttle(quad)[env_ids]
+        self.y = y
+
+    def detach_state(self):
+        """Cut the graph to the previous segment at the start of each BPTT segment."""
+        self.cmd_hist = self.cmd_hist.detach().clone()
+        self.y = self.y.detach().clone()
+
+    # ------------------------------------------------------------------ per step
+    def _push(self, command):
+        if self.delay and self.jitter_rng[1] > 0.0:
+            d_new = self.d_base + self._uniform(self.jitter_rng, self.n)
+        else:
+            d_new = self.d_base
+        self.cmd_hist = torch.cat([command.unsqueeze(1), self.cmd_hist[:, :-1]], dim=1)
+        self.cmd_delay = torch.cat([d_new.unsqueeze(1), self.cmd_delay[:, :-1]], dim=1)
+
+    def _effective(self, t_in):
+        """The command in effect at time t_in within this step: the newest one that has arrived (delay - j*dt <= t_in); if none has, the oldest."""
+        arrived = (self.cmd_delay - self.j_dt) <= (t_in + 1e-6)          # 1 us tolerance: rounding must not turn "just arrived" into "not yet"
+        j = torch.where(arrived, self.j_idx, self.j_last).amin(dim=1)
+        return self.cmd_hist[self.env_idx, j], j
+
+    def simulate(self, quad, position, velocity, orientation, angular_velocity, command, step_count):
+        """Replaces QuadrotorSimulator.run_simulation (same return order). command = this step's mixed command (N, 4):
+        3 body rates (body FLU, rad/s) + thrust fraction f (0-0.5). step_count = steps since the episode start (progress_buf)."""
+        self._push(command)
+        n_sub, h = quad.n_steps, float(quad.dt)
+        motor_speeds = torch.zeros_like(command[:, 3])
+        hold = self.hold_start_s > 0.0
+        if hold:
+            t0 = step_count.to(torch.float32) * self.dt
+            zero_rates = torch.zeros_like(command[:, 0:3])
+        if self.motor:
+            scale = quad.m * G if self.thrust_ref == "weight" else quad.max_thrust * self.f_hover_prog   # S (see the header)
+            if hold:
+                y_hold = self._hover_throttle(quad)
+            a_up = 1.0 - torch.exp(-h / self.tau_up)
+            a_dn = 1.0 - torch.exp(-h / self.tau_dn)
+        elif hold:
+            f_hover_true = quad.m * G / quad.max_thrust
+        y = self.y
+        rec = self.record
+        if rec:
+            thr_sum = torch.zeros_like(motor_speeds)
+            f_sum = torch.zeros_like(motor_speeds)
+        j = torch.zeros(self.n, dtype=torch.long, device=self.device)
+        for i in range(n_sub):
+            t_in = i * h
+            if self.delay:
+                eff, j = self._effective(t_in)
+            else:
+                eff = command
+            rates, f = eff[:, 0:3], eff[:, 3]
+            if hold:
+                in_hold = (t0 + t_in) < self.hold_start_s
+                rates = torch.where(in_hold.unsqueeze(1), zero_rates, rates)
+            if self.motor:
+                u_cmd = torch.clamp(self.t_hover_prog * (f.clamp(min=1e-6) / self.f_hover_prog) ** (1.0 / self.p_prog), 0.0, 1.0)
+                if hold:
+                    u_cmd = torch.where(in_hold, y_hold, u_cmd)
+                y = y + torch.where(u_cmd > y, a_up, a_dn) * (u_cmd - y)
+                force = scale * (y / self.u_hover) ** self.p_real
+            else:
+                force = None
+                if hold:
+                    f = torch.where(in_hold, f_hover_true, f)
+            position, velocity, orientation, angular_velocity, lin_acc, ang_acc, motor_speeds = quad.update(
+                position, velocity, orientation, angular_velocity, rates, f, motor_speeds, thrust_force=force)
+            if rec:
+                with torch.no_grad():
+                    thr_sum += (force if force is not None else f * quad.max_thrust) / (quad.m * G)
+                    f_sum += f
+        self.y = y
+        if rec:
+            self.last = dict(thrust_over_weight=(thr_sum / n_sub).detach(), f_eff=(f_sum / n_sub).detach(),
+                             y=y.detach().clone(), j_last=j.detach().clone())
+        return position, velocity, angular_velocity, orientation, lin_acc, ang_acc
diff --git a/envs/assets/height_integrator.py b/envs/assets/height_integrator.py
