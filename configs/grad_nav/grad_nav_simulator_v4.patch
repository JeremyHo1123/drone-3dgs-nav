index 0000000..b7e3ae7
--- /dev/null
+++ b/envs/assets/height_integrator.py
@@ -0,0 +1,62 @@
+# Added in this project (2026-10-29, v4): height integrator.
+#
+# Why: v3 (retrained with the real-drone latency) corrects height about 6x more gently than v2, so that it does not
+#   oscillate under latency. The policy has no integral action, so any difference between the real hover thrust and
+#   the hover it "believes in" becomes a constant height offset: about 1.1 cm lower for every 1% of extra mass (v2:
+#   about 0.18 cm), and a heavy airframe stays 20 cm low for the whole 35 s. Integral action removes constant offsets
+#   without stronger corrections, and also handles every slowly changing thrust error (airframe mass, battery voltage
+#   sag, an inaccurate thrust curve).
+#
+# How: the mixed thrust command (the one env.step stores in self.actions) gets f_I added before the physics (or the
+#   latency model):
+#     f_I <- clamp(f_I + k_I*dt*clamp(H - z, -e_clip, e_clip), -f_max, f_max)
+#     z = the height observation the policy sees this step (with observation noise in training); no e_clip = no limit
+#     (a limit reduces wind-up when the start is far from the target)
+#     thrust sent = clamp(f + f_I, 0, 0.5)
+#   f_I = 0 at episode start; no accumulation during the first freeze_s seconds. The action in the policy observation
+#   excludes f_I (as without the integrator).
+#   orbit_policy/orbit_runtime.py does exactly the same on the drone (the bundle meta records k_I, f_max, freeze_s,
+#   e_clip and H).
+#
+# Settings (env_hyper.HEIGHT_INTEGRATOR): enabled (anything but True = no integrator, the environment is step for step
+#   unchanged), k_I [1/(m*s)], f_max, freeze_s, e_clip [m].
+# Differentiable (all torch ops, no in-place writes); detach_state() at the start of each BPTT segment; reset() zeroes it.
+import torch
+
+
+class HeightIntegrator:
+    def __init__(self, cfg, num_envs, device, dt, target_height):
+        self.cfg = dict(cfg)
+        self.k_I = float(cfg.get('k_I', 0.10))
+        self.f_max = float(cfg.get('f_max', 0.06))
+        self.freeze_s = float(cfg.get('freeze_s', 0.0))
+        e_clip = cfg.get('e_clip', None)
+        self.e_clip = None if e_clip is None else float(e_clip)
+        if self.k_I < 0 or self.f_max < 0 or self.freeze_s < 0 or (self.e_clip is not None and self.e_clip <= 0):
+            raise ValueError(f"HEIGHT_INTEGRATOR k_I, f_max and freeze_s must not be negative and e_clip must be > 0: {cfg}")
+        self.cfg.update(k_I=self.k_I, f_max=self.f_max, freeze_s=self.freeze_s, e_clip=self.e_clip)
+        self.dt = float(dt)
+        self.H = float(target_height)
+        self.f_I = torch.zeros(num_envs, device=device)
+
+    def reset(self, env_ids):
+        f = self.f_I.clone()                       # clone before writing: the old tensor may already be in the graph
+        f[env_ids] = 0.0
+        self.f_I = f
+
+    def detach_state(self):
+        self.f_I = self.f_I.detach().clone()
+
+    def apply(self, command, z_obs, step_count):
+        """command: this step's mixed command (N, 4) (3 body rates + thrust fraction f). Returns a new tensor for the physics; command is not modified.
+        z_obs: the height the policy sees this step (N,); step_count: steps since the episode start, progress_buf (N,)."""
+        e = self.H - z_obs
+        if self.e_clip is not None:
+            e = torch.clamp(e, -self.e_clip, self.e_clip)
+        upd = torch.clamp(self.f_I + self.k_I * self.dt * e, -self.f_max, self.f_max)
+        if self.freeze_s > 0.0:
+            active = (step_count.to(torch.float32) * self.dt) >= self.freeze_s
+            upd = torch.where(active, upd, self.f_I)
+        self.f_I = upd
+        thrust = torch.clamp(command[:, 3] + self.f_I, 0.0, 0.5)
+        return torch.cat([command[:, 0:3], thrust.unsqueeze(1)], dim=1)
