+def proper_heading_xy(quat_xyzw):
+    """Horizontal component of the body x axis in the world frame (correct rotation formula, consistent with the dynamics and the obstacle cone), normalised."""
+    x, y, z, w = quat_xyzw[:, 0], quat_xyzw[:, 1], quat_xyzw[:, 2], quat_xyzw[:, 3]
+    fx = 1 - 2 * (y * y + z * z)
+    fy = 2 * (x * y + w * z)
+    h = torch.stack((fx, fy), dim=1)
+    return h / (torch.norm(h, dim=-1, keepdim=True) + 1e-8)
+
+
+def tilt_quat(quat_xyzw):
+    """Attitude quaternion (x,y,z,w) with yaw removed: q_tilt = q_yaw(psi)^-1 * q, psi = direction of the body x axis projected on the ground; w >= 0.
+    Independent of world yaw; w only approaches 0 near 180 deg of tilt, so it is continuous and unique in normal flight."""
+    x, y, z, w = quat_xyzw[:, 0], quat_xyzw[:, 1], quat_xyzw[:, 2], quat_xyzw[:, 3]
+    half = 0.5 * torch.atan2(2 * (x * y + w * z), 1 - 2 * (y * y + z * z))
+    zero = torch.zeros_like(half)
+    q_yaw_inv = torch.stack([zero, zero, -torch.sin(half), torch.cos(half)], dim=1)
+    qt = tu.quat_mul(q_yaw_inv, quat_xyzw)
+    return torch.where(qt[:, 3:4] < 0, -qt, qt)
+
+
+def to_heading_frame(vec_xyz, heading_xy):
+    """World-frame vector to the heading frame (forward, left, up): yaw only, no tilt. heading_xy is the normalised horizontal nose direction."""
+    hx, hy = heading_xy[:, 0], heading_xy[:, 1]
+    fwd = hx * vec_xyz[:, 0] + hy * vec_xyz[:, 1]
+    left = -hy * vec_xyz[:, 0] + hx * vec_xyz[:, 1]
+    return torch.stack([fwd, left, vec_xyz[:, 2]], dim=1)
+
