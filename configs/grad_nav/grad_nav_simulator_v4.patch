+++ b/envs/assets/quadrotor_dynamics_advanced.py
@@ -71,15 +71,24 @@ class QuadrotorSimulator:
 
         R = torch.zeros((batch_size, 3, 3), device=self.device)
 
+        # NOTE: upstream bug fix (changed in this project)
+        #   [0,2] used to be 2*(x*z - w*y) and [2,0] 2*(x*z + w*y): the sign of w*y was swapped.
+        #   Effect: pure yaw and pure roll were still right, but pure pitch was fully reversed,
+        #   and any combined rotation did not even give a rotation matrix
+        #   (measured for a combined rotation: |R R^T - I| = 0.42, det = 0.76).
+        #   This is not a convention difference -- in any convention a rotation matrix is orthogonal with det = 1.
+        #   utils/gs_local.py:200-204 in the same repo has the same formula, correctly,
+        #   for comparison. After the fix, pure yaw / pure roll / pure pitch and a combined rotation all match
+        #   scipy.spatial.transform.Rotation (difference ~1e-16).
