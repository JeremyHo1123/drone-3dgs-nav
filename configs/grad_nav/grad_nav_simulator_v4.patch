+    # ------------------------------------------------------------------
+    def _sample_start(self, env_ids, fixed=False):
+        """Start on the circle: angle 0 when fixed (evaluation, reproducible), otherwise uniform random. Nose at the box."""
+        n = len(env_ids)
+        th = torch.zeros(n, device=self.device) if fixed else torch.rand(n, device=self.device) * 2 * math.pi
+        pos = torch.stack([self.orbit_center[0] + self.orbit_radius * torch.cos(th),
+                           self.orbit_center[1] + self.orbit_radius * torch.sin(th),
+                           torch.full_like(th, self.orbit_height)], dim=1)
+        psi = th + math.pi
+        quat = torch.stack([torch.zeros_like(psi), torch.zeros_like(psi), torch.sin(psi / 2), torch.cos(psi / 2)], dim=1)
+        self.start_pos[env_ids] = pos
+        self.start_quat[env_ids] = quat
+
+    def init_sim(self):
